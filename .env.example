# Application
FARM_NAME=CHEGOLAND AGRI-EMPIRE LTD DAIRY FARM AND SHOP
APP_DESCRIPTION=Fresh dairy from our zero-grazing herd in Kapcholyo, Kaplong and its environs
FARM_LOCATION=Kapcholyo, Kaplong and its environs
DEBUG=True
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dairy_farm.db

# Server
HOST=0.0.0.0
PORT=8000

# M-Pesa Daraja (Sandbox)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_MOCK_MODE=true

# Email / SMTP (console logger by default)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@chegoland.com

# Africa's Talking SMS (optional)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Admin credentials (seeded on first run)
ADMIN_EMAIL=admin@chegoland.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters